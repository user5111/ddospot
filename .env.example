# Mail alerting settings - values set here override the [alerting] section
# of every pot configuration file (docker-compose automatically loads this file).
# Copy to .env and fill in real values.

DDOSPOT_MAIL_HOST=mail.server.com
DDOSPOT_MAIL_PORT=25
DDOSPOT_MAIL_USERNAME=username
DDOSPOT_MAIL_PASSWORD=password

# Mail transport security: None, SSL or STARTTLS
DDOSPOT_MAIL_SEC=None

DDOSPOT_MAIL_FROM=name@mail.com

# Comma-separated list of alert recipients
DDOSPOT_MAIL_TO=name@mail.com

# Path to GeoIP mmdb file (default: data/GeoIP.mmdb, downloaded in Dockerfile from Loyalsoldier/geoip)
# DDOSPOT_GEOIP_DB=data/GeoIP.mmdb
