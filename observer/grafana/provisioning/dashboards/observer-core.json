{
  "title": "DDoSPot Observer - Attack Trends",
  "uid": "ddospot-observer-core",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "1m",
  "time": {"from": "now-7d", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Attack events over time by pot  (NOTE: src_ip may be spoofed victim in reflection attacks)",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "frser-sqlite-datasource", "uid": "DDoSPotWarehouse"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "frser-sqlite-datasource", "uid": "DDoSPotWarehouse"},
          "format": "time_series",
          "rawQuery": true,
          "queryText": "SELECT (strftime('%s', start)) * 1000 AS time, pot AS metric, count(*) AS value FROM events WHERE start >= datetime('now', '-7 days') GROUP BY time, pot ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10}},
        "overrides": []
      },
      "options": {
        "legend": {"showLegend": true, "displayMode": "table", "placement": "right"}
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total events (7d)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 12},
      "datasource": {"type": "frser-sqlite-datasource", "uid": "DDoSPotWarehouse"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "frser-sqlite-datasource", "uid": "DDoSPotWarehouse"},
          "format": "table",
          "rawQuery": true,
          "queryText": "SELECT count(*) as total FROM events WHERE start >= datetime('now', '-7 days')"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unique attacker IPs (7d)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 12},
      "datasource": {"type": "frser-sqlite-datasource", "uid": "DDoSPotWarehouse"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "frser-sqlite-datasource", "uid": "DDoSPotWarehouse"},
          "format": "table",
          "rawQuery": true,
          "queryText": "SELECT count(DISTINCT src_ip) as ips FROM events WHERE start >= datetime('now', '-7 days')"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active honeypot nodes",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 12},
      "datasource": {"type": "frser-sqlite-datasource", "uid": "DDoSPotWarehouse"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "frser-sqlite-datasource", "uid": "DDoSPotWarehouse"},
          "format": "table",
          "rawQuery": true,
          "queryText": "SELECT count(DISTINCT node) as nodes FROM events WHERE start >= datetime('now', '-7 days')"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top 10 source countries (7d)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "frser-sqlite-datasource", "uid": "DDoSPotWarehouse"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "frser-sqlite-datasource", "uid": "DDoSPotWarehouse"},
          "format": "table",
          "rawQuery": true,
          "queryText": "SELECT country_code || ' ' || COALESCE(country_name,'?') as Country, count(*) as Events, count(DISTINCT src_ip) as Unique_IPs FROM events WHERE start >= datetime('now', '-7 days') GROUP BY country_code, country_name ORDER BY Events DESC LIMIT 10"
        }
      ],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true}
    },
    {
      "id": 6,
      "type": "table",
      "title": "Events by node and pot (7d)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "frser-sqlite-datasource", "uid": "DDoSPotWarehouse"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "frser-sqlite-datasource", "uid": "DDoSPotWarehouse"},
          "format": "table",
          "rawQuery": true,
          "queryText": "SELECT node as Node, pot as Pot, count(*) as Events, count(DISTINCT src_ip) as Unique_IPs FROM events WHERE start >= datetime('now', '-7 days') GROUP BY node, pot ORDER BY Events DESC"
        }
      ],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true}
    }
  ]
}
